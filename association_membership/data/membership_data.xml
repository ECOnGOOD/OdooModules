<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="product_category_membership" model="product.category">
        <field name="name">Membership</field>
    </record>

    <!-- The default member numbering (15.22, D31). A company with own numbering
         has a sequence with the same code and its own company_id. -->
    <record id="seq_association_membership_number" model="ir.sequence">
        <field name="name">Member Number (default)</field>
        <field name="code">association.membership.number.seq</field>
        <field name="prefix">MEM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>
