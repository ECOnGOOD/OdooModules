<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="mail_template_membership_activation_invoice" model="mail.template">
        <field name="name">Membership: Activation Invoice</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="subject">Your membership invoice {{ object.name }} - {{ object.company_id.name }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.partner_id.name"/>,</p>
    <p>Thank you for your membership. Here are the details of your membership invoice:</p>
    <ul>
        <li>Invoice: <strong><t t-out="object.name"/></strong></li>
        <li>Amount due: <strong><t t-out="object.amount_total" t-options="{'widget': 'monetary', 'display_currency': object.currency_id}"/></strong></li>
        <li>Due date: <t t-out="object.invoice_date_due" t-options="{'widget': 'date'}"/></li>
    </ul>
    <p>You can view and pay this invoice online through the customer portal.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name"/></p>
</div>
        </field>
    </record>

    <record id="mail_template_membership_welcome" model="mail.template">
        <field name="name">Membership: Welcome</field>
        <field name="model_id" ref="association_membership.model_membership_membership" />
        <field name="subject">Welcome, {{ object.partner_id.name }}!</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.partner_id.name"/>,</p>
    <p>We are delighted to welcome you as a member. Your membership details:</p>
    <ul>
        <li>Membership number: <strong><t t-out="object.membership_number"/></strong></li>
        <li>Membership: <t t-out="object.product_id.name"/></li>
        <li>Member since: <t t-out="object.date_start" t-options="{'widget': 'date'}"/></li>
        <li>Annual fee: <t t-out="object.amount" t-options="{'widget': 'monetary', 'display_currency': object.currency_id}"/></li>
    </ul>
    <p>If you have any questions about your membership, simply reply to this email.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name"/></p>
</div>
        </field>
    </record>

    <record id="mail_template_membership_cancellation" model="mail.template">
        <field name="name">Membership: Cancellation</field>
        <field name="model_id" ref="association_membership.model_membership_membership" />
        <field name="subject">Confirmation of your membership cancellation - {{ object.company_id.name }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.partner_id.name"/>,</p>
    <p>We hereby confirm the cancellation of your membership:</p>
    <ul>
        <li>Membership number: <strong><t t-out="object.membership_number"/></strong></li>
        <li>Cancellation date: <t t-out="object.date_cancelled" t-options="{'widget': 'date'}"/></li>
        <li>Membership ends on: <t t-out="object.date_end" t-options="{'widget': 'date'}"/></li>
    </ul>
    <t t-if="object.cancel_reason">
        <p>Reason stated: <t t-out="object.cancel_reason"/>.</p>
    </t>
    <p>We thank you for your membership and hope to welcome you back in the future.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name"/></p>
</div>
        </field>
    </record>
</odoo>
