<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_current_memberships" model="ir.actions.act_window">
        <field name="name">Current Memberships</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_list" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="domain">[('membership_active', '=', True)]</field>
    </record>

    <record id="action_report_unpaid_memberships" model="ir.actions.act_window">
        <field name="name">Unpaid Memberships</field>
        <field name="res_model">membership.period</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="view_id" ref="association_membership.view_membership_period_list" />
        <field name="search_view_id" ref="association_membership.view_membership_period_search" />
        <field name="domain">[('billing_status', 'in', ('to_invoice', 'invoiced', 'partial'))]</field>
    </record>

    <record id="action_report_period_history" model="ir.actions.act_window">
        <field name="name">Period History</field>
        <field name="res_model">membership.period</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="view_id" ref="association_membership.view_membership_period_list" />
        <field name="search_view_id" ref="association_membership.view_membership_period_search" />
    </record>

    <record id="action_report_renewal_candidates" model="ir.actions.act_window">
        <field name="name">Renewal Candidates</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_list" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="domain">[('membership_active', '=', True)]</field>
    </record>

    <record id="action_report_cancellations" model="ir.actions.act_window">
        <field name="name">Scheduled to End</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_cancellations_list" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="domain">[('state', '=', 'cancelled')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cancellations pending</p>
            <p>Memberships that are cancelled but still run until their end date.</p>
        </field>
    </record>

    <record id="action_report_former_members" model="ir.actions.act_window">
        <field name="name">Former Members</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_cancellations_list" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="domain">[('state', '=', 'terminated')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No former members</p>
            <p>Memberships that have ended. Use "Reopen" on a membership if a member returns.</p>
        </field>
    </record>

    <record id="action_report_new_members" model="ir.actions.act_window">
        <field name="name">New Members</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_list" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="context">{'search_default_recent_starts': 1}</field>
    </record>

    <record id="action_report_company_member_list" model="ir.actions.act_window">
        <field name="name">Per-company Member List</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_list" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="domain">['|', ('membership_active', '=', True), ('state', '=', 'waiting')]</field>
        <field name="context">{'group_by': 'company_id'}</field>
    </record>
</odoo>
