<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_membership" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.membership</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Membership" name="association_membership" groups="association_membership.group_membership_manager">
                    <block title="Membership">
                        <setting string="Membership Product Category">
                            <field name="membership_product_category_id" />
                        </setting>
                        <setting string="Auto-activate on Payment">
                            <field name="membership_auto_activate_on_payment" />
                        </setting>
                        <setting
                            string="Contribution Year Override"
                            help="Leave empty to always use the current year. Set a future year to default new contributions to that year, e.g. for early renewals."
                        >
                            <field
                                name="membership_default_contribution_year_text"
                                placeholder="e.g. 2027 (empty = current year)"
                            />
                        </setting>
                        <setting string="Invoicing Strategy">
                            <field name="membership_invoicing_strategy" />
                        </setting>
                        <setting
                            string="Renewal Year Offset"
                            help="Target year used by the renewal cron: current year + offset."
                        >
                            <field name="membership_cron_year_offset" />
                        </setting>
                    </block>
                    <block title="Communications">
                        <setting string="Activation Invoice Email Template">
                            <field
                                name="membership_activation_invoice_template_id"
                                domain="[('model', '=', 'account.move')]"
                            />
                        </setting>
                        <setting string="Welcome Email Template">
                            <field
                                name="membership_welcome_template_id"
                                domain="[('model', '=', 'membership.membership')]"
                            />
                        </setting>
                        <setting string="Cancellation Email Template">
                            <field
                                name="membership_cancellation_template_id"
                                domain="[('model', '=', 'membership.membership')]"
                            />
                        </setting>
                    </block>
                    <block title="Member Numbers">
                        <setting
                            string="Member Number Prefix"
                            help="Prefix for generated member numbers. %%(year)s resolves to the creation year."
                        >
                            <field name="member_number_prefix" />
                        </setting>
                        <setting
                            string="Member Number Padding"
                            help="Zero-padding of the counter part of the member number."
                        >
                            <field name="member_number_padding" />
                        </setting>
                        <setting
                            string="Next Member Number"
                            help="Raw counter used for the next generated member number."
                        >
                            <field name="member_number_next" />
                        </setting>
                        <setting
                            string="Next Member Number (Preview)"
                            help="How the next generated member number will look."
                        >
                            <field name="member_number_preview" readonly="1" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_membership_settings" model="ir.actions.act_window">
        <field name="name">Membership Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'association_membership'}</field>
    </record>
</odoo>
