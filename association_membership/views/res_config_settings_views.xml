<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_membership" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.membership</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Membership" name="association_membership" groups="association_membership.group_membership_manager">
                    <block title="Membership">
                        <!-- Settings apply to the company selected in the switcher, not to all (15.10). -->
                        <setting
                            string="Company"
                            help="These settings apply to this company only: the one selected in the company switcher. A membership follows the settings of its own company."
                            groups="base.group_multi_company"
                        >
                            <field name="company_id" readonly="1" />
                        </setting>
                        <setting
                            string="Email Recipients for Organisation Members"
                            help="Who receives welcome and cancellation emails of organisation members. Individuals always receive their own emails. The contact person is the one set on the organisation, or the organisation itself."
                        >
                            <field name="membership_company_mail_recipients" />
                        </setting>
                        <setting
                            string="Period Year Override"
                            help="Leave at 0 to always use the current year. Set a future year to default new periods to that year, e.g. for early renewals."
                        >
                            <field
                                name="membership_default_period_year"
                                options="{'enable_formatting': false}"
                                placeholder="e.g. 2027 (0 = current year)"
                            />
                        </setting>
                        <setting
                            string="Invoicing Strategy"
                            help="Default for new memberships; a membership may override it. Manual: no invoice is created automatically - record payments with &quot;Mark as Paid&quot;, or create an invoice by hand when one is needed. Draft: activation and renewal create a draft invoice. Confirm: activation and renewal create and post the invoice."
                        >
                            <field name="membership_invoicing_strategy" />
                        </setting>
                    </block>
                    <block title="Communications">
                        <setting
                            string="Activation Invoice Email Template"
                            help="Used when an activation sends the membership invoice. Not used while the invoicing strategy is Manual."
                            invisible="membership_invoicing_strategy == 'manual'"
                        >
                            <field
                                name="membership_activation_invoice_template_id"
                                domain="[('model', '=', 'account.move')]"
                            />
                        </setting>
                        <setting string="Welcome Email Template">
                            <field
                                name="membership_welcome_template_id"
                                domain="[('model', '=', 'membership.membership')]"
                            />
                        </setting>
                        <setting string="Cancellation Email Template">
                            <field
                                name="membership_cancellation_template_id"
                                domain="[('model', '=', 'membership.membership')]"
                            />
                        </setting>
                        <setting
                            string="Organisation Templates"
                            help="Optional. When set, organisation members get these instead of the templates above; empty means the template above. A single template can also differ by member type with sections like t-if=&quot;object.partner_id.is_company&quot;."
                        >
                            <div class="content-group">
                                <div class="row mt8" invisible="membership_invoicing_strategy == 'manual'">
                                    <label for="membership_activation_invoice_org_template_id" string="Activation Invoice" class="col-lg-4 o_light_label" />
                                    <field
                                        name="membership_activation_invoice_org_template_id"
                                        domain="[('model', '=', 'account.move')]"
                                        class="col-lg-8"
                                    />
                                </div>
                                <div class="row mt8">
                                    <label for="membership_welcome_org_template_id" string="Welcome" class="col-lg-4 o_light_label" />
                                    <field
                                        name="membership_welcome_org_template_id"
                                        domain="[('model', '=', 'membership.membership')]"
                                        class="col-lg-8"
                                    />
                                </div>
                                <div class="row mt8">
                                    <label for="membership_cancellation_org_template_id" string="Cancellation" class="col-lg-4 o_light_label" />
                                    <field
                                        name="membership_cancellation_org_template_id"
                                        domain="[('model', '=', 'membership.membership')]"
                                        class="col-lg-8"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Tax Receipt Email Template"
                            help="Used when tax receipts are sent, one at a time or several from the list. Empty: the default template (the Zuwendungsbestätigung for German companies, when installed)."
                        >
                            <field
                                name="membership_tax_receipt_template_id"
                                domain="[('model', '=', 'donation.tax.receipt')]"
                            />
                        </setting>
                    </block>
                    <block title="Member Numbers">
                        <setting
                            string="Own Member Numbering"
                            help="Off (recommended): the default numbering, one counter shared by all companies, so numbers cannot collide. On: this company numbers on its own, starting where the default counter stands; its prefix must differ from every other company's."
                        >
                            <field name="member_number_own_sequence" />
                        </setting>
                        <setting
                            string="Number Format"
                            help="Placeholders in prefix and suffix: %%(year)s, %%(y)s, %%(month)s, %%(day)s. The default format is changed by an administrator on its sequence (Technical → Sequences)."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="member_number_prefix" class="col-lg-4 o_light_label" />
                                    <field name="member_number_prefix" readonly="not member_number_own_sequence" />
                                </div>
                                <div class="row">
                                    <label for="member_number_suffix" class="col-lg-4 o_light_label" />
                                    <field name="member_number_suffix" readonly="not member_number_own_sequence" />
                                </div>
                                <div class="row">
                                    <label for="member_number_padding" class="col-lg-4 o_light_label" />
                                    <field name="member_number_padding" readonly="not member_number_own_sequence" />
                                </div>
                                <div class="row">
                                    <label for="member_number_next" class="col-lg-4 o_light_label" />
                                    <field name="member_number_next" readonly="not member_number_own_sequence" />
                                </div>
                                <div class="row">
                                    <label for="member_number_preview" class="col-lg-4 o_light_label" />
                                    <field name="member_number_preview" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_membership_settings" model="ir.actions.act_window">
        <field name="name">Membership Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'association_membership'}</field>
    </record>
</odoo>
