<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_activate_wizard_form" model="ir.ui.view">
        <field name="name">membership.activate.wizard.form</field>
        <field name="model">membership.activate.wizard</field>
        <field name="arch" type="xml">
            <form string="Activate Membership">
                <group>
                    <field name="membership_id" />
                    <field name="invoicing_strategy" />
                    <field name="invoicing_strategy_source" nolabel="1" colspan="2" readonly="1" class="text-muted" />
                </group>
                <group string="Period" invisible="has_period">
                    <field name="has_period" invisible="1" />
                    <field name="period_year" options="{'enable_formatting': false}" readonly="1" />
                    <field name="create_period" />
                </group>
                <field name="free_period_warning" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not free_period_warning"
                >
                    <field name="free_period_warning" nolabel="1" readonly="1" />
                </div>
                <group
                    string="Invoice"
                    invisible="invoicing_strategy != 'confirm' or (not invoice_id and not create_period and not has_period)"
                >
                    <field name="invoice_id" readonly="1" invisible="not invoice_id" />
                    <field name="send_invoice_email" />
                </group>
                <group string="Welcome Message">
                    <field name="send_welcome_message" />
                    <field
                        name="welcome_template_id"
                        invisible="not send_welcome_message"
                        options="{'no_create': True}"
                    />
                </group>
                <group invisible="not send_welcome_message">
                    <field name="invoice_partner_included" invisible="1" />
                    <label for="mail_partner_ids" />
                    <div class="o_row" name="mail_partner_ids">
                        <field name="mail_partner_ids" widget="many2many_tags" nolabel="1" />
                        <button
                            name="action_add_invoice_partner"
                            string="Add Invoice Contact"
                            type="object"
                            icon="fa-user-plus"
                            class="btn-link"
                            invisible="invoice_partner_included"
                        />
                    </div>
                    <field name="mail_subject" />
                    <field name="mail_body" widget="html" />
                </group>
                <footer>
                    <button name="action_confirm" string="Activate" type="object" class="btn-primary" />
                    <button string="Discard" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
