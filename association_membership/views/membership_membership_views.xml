<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_membership_kanban" model="ir.ui.view">
        <field name="name">membership.membership.kanban</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1" records_draggable="false">
                <field name="partner_id" />
                <field name="product_id" />
                <field name="company_id" />
                <field name="membership_number" />
                <field name="state" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="active" />
                <field name="partner_avatar_128" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                        <aside class="o_kanban_aside_full">
                            <field
                                name="partner_avatar_128"
                                alt="Member"
                                class="w-100 h-100"
                                widget="image"
                                options="{'img_class': 'object-fit-cover w-100 h-100'}"
                            />
                        </aside>
                        <main class="ps-3">
                            <div class="fw-bold fs-5">
                                <field name="partner_id" />
                            </div>
                            <div class="text-muted">
                                <field name="product_id" />
                            </div>
                            <div t-if="record.membership_number.value" class="mt-2 text-body">
                                <field name="membership_number" />
                            </div>
                            <div class="text-muted mt-2">
                                <field name="company_id" />
                            </div>
                            <div class="text-muted mt-1">
                                <span>Start </span>
                                <field name="date_start" />
                            </div>
                            <div t-if="(record.state.raw_value == 'cancelled' or record.state.raw_value == 'terminated') and record.date_end.raw_value" class="text-muted">
                                <span>End </span>
                                <field name="date_end" />
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_membership_membership_list" model="ir.ui.view">
        <field name="name">membership.membership.list</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <list>
                <field name="membership_number" />
                <field name="partner_id" />
                <field name="company_id" />
                <field name="product_id" />
                <field name="state" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="last_period_year" options="{'enable_formatting': false}" optional="hide" />
                <field name="last_billing_status" />
                <field name="invoice_partner_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_membership_membership_cancellations_list" model="ir.ui.view">
        <field name="name">membership.membership.cancellations.list</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <list>
                <field name="membership_number" />
                <field name="partner_id" />
                <field name="company_id" />
                <field name="product_id" />
                <field name="state" />
                <field name="date_start" />
                <field name="date_cancelled" />
                <field name="date_end" />
                <field name="cancel_reason" />
            </list>
        </field>
    </record>

    <record id="view_membership_membership_search" model="ir.ui.view">
        <field name="name">membership.membership.search</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="membership_number" />
                <field name="partner_id" />
                <field name="invoice_partner_id" />
                <field name="product_id" />
                <field name="company_id" />
                <field name="state" />
                <field name="date_start" />
                <field name="date_end" />
                <filter
                    name="open_memberships"
                    string="Waiting + Current"
                    domain="[('state', 'in', ('waiting', 'active', 'cancelled'))]"
                />
                <filter
                    name="active_memberships"
                    string="Active"
                    domain="[('membership_active', '=', True)]"
                />
                <filter
                    name="cancelled_memberships"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <filter
                    name="terminated_memberships"
                    string="Terminated"
                    domain="[('state', '=', 'terminated')]"
                />
                <filter
                    name="recent_starts"
                    string="Started in last 90 days"
                    domain="[('date_start', '&gt;=', (context_today() - relativedelta(days=90)).strftime('%Y-%m-%d'))]"
                />
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" />
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}" />
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_membership_membership_form" model="ir.ui.view">
        <field name="name">membership.membership.form</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_submit"
                        string="Submit"
                        type="object"
                        groups="association_membership.group_membership_manager"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_activate"
                        string="Activate"
                        type="object"
                        class="oe_highlight"
                        groups="association_membership.group_membership_manager"
                        invisible="not id or state not in ('draft', 'waiting')"
                    />
                    <button
                        name="action_activate"
                        string="Reactivate"
                        type="object"
                        groups="association_membership.group_membership_manager"
                        invisible="state != 'cancelled'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel Membership"
                        type="object"
                        groups="association_membership.group_membership_manager"
                        invisible="state != 'active'"
                    />
                    <button
                        name="action_cancel"
                        string="Edit Cancellation"
                        type="object"
                        groups="association_membership.group_membership_manager"
                        invisible="state != 'cancelled'"
                    />
                    <button
                        name="action_revert_to_draft"
                        string="Revert to Draft"
                        type="object"
                        groups="association_membership.group_membership_manager"
                        invisible="state not in ('waiting', 'cancelled', 'terminated')"
                        confirm="Revert this membership to draft? It stops counting as a membership until it is submitted again, and any cancellation data is cleared."
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,waiting,active,cancelled,terminated"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_periods"
                            string="Periods"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                        >
                            <field name="period_count" widget="statinfo" />
                        </button>
                        <button
                            name="action_view_invoices"
                            string="Invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="partner_is_company" invisible="1" />
                            <!-- Both come from the organisation; change them there (15.26). -->
                            <field name="invoice_partner_id" invisible="not partner_is_company" />
                            <field name="contact_partner_id" invisible="not partner_is_company" />
                            <field name="company_id" />
                            <!-- One row: the preview and the input take turns in the same place,
                                 and the Override box stays on the right. -->
                            <label for="membership_number" string="Membership Number" />
                            <div class="d-flex align-items-baseline w-100">
                                <field
                                    name="membership_number_preview"
                                    readonly="1"
                                    nolabel="1"
                                    class="flex-grow-1 text-muted"
                                    invisible="id or override_membership_number"
                                />
                                <field
                                    name="membership_number"
                                    nolabel="1"
                                    class="flex-grow-1"
                                    invisible="not id and not override_membership_number"
                                />
                                <div class="d-flex align-items-baseline flex-shrink-0 ms-3" invisible="id">
                                    <field name="override_membership_number" nolabel="1" />
                                    <label for="override_membership_number" string="Override" class="o_form_label ms-1" />
                                </div>
                            </div>
                            <field name="product_domain" invisible="1" />
                            <field name="product_id" domain="product_domain" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="amount" groups="association_membership.group_membership_manager" />
                            <label for="invoicing_strategy" groups="association_membership.group_membership_manager" />
                            <!-- Which one applies: the company's or this override (15.10). -->
                            <div class="o_row" groups="association_membership.group_membership_manager">
                                <field name="invoicing_strategy" placeholder="Company default" />
                                <span class="text-muted" invisible="invoicing_strategy">
                                    company: <field name="company_invoicing_strategy" readonly="1" class="oe_inline" />
                                </span>
                                <span class="text-muted" invisible="not invoicing_strategy">
                                    overrides the company's <field name="company_invoicing_strategy" readonly="1" class="oe_inline" />
                                </span>
                            </div>
                        </group>
                    </group>
                    <group
                        string="Cancellation"
                        invisible="state not in ('cancelled', 'terminated')"
                    >
                        <group>
                            <field name="date_cancelled" readonly="1" />
                            <field name="date_end" readonly="1" />
                            <field name="cancel_reason" readonly="1" invisible="not cancel_reason" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" invisible="state == 'draft' and not period_count">
                            <button
                                name="action_create_period"
                                string="Create Period"
                                type="object"
                                class="oe_highlight"
                                groups="association_membership.group_membership_manager"
                                invisible="state == 'draft'"
                            />
                            <field name="duplicate_period_year_warning" invisible="1" />
                            <div
                                class="alert alert-warning"
                                role="alert"
                                invisible="not duplicate_period_year_warning"
                            >
                                <field
                                    name="duplicate_period_year_warning"
                                    nolabel="1"
                                    readonly="1"
                                />
                            </div>
                            <field
                                name="period_ids"
                                mode="list,form"
                                context="{'default_membership_id': id, 'form_view_ref': 'association_membership.view_membership_period_form', 'form_view_initial_mode': 'edit'}"
                            >
                                <list create="0" delete="0" open_form_view="1">
                                    <field name="membership_year" string="Year" options="{'enable_formatting': false}" />
                                    <field name="amount" />
                                    <field name="amount_paid" />
                                    <field name="billing_status" />
                                    <field name="invoice_id" />
                                    <field name="refund_move_id" optional="hide" />
                                    <field name="tax_receipt_id" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_members_overview" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="association_membership.view_membership_membership_kanban" />
        <field name="search_view_id" ref="association_membership.view_membership_membership_search" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
