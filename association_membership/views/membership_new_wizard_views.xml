<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_new_wizard_form" model="ir.ui.view">
        <field name="name">membership.new.wizard.form</field>
        <field name="model">membership.new.wizard</field>
        <field name="arch" type="xml">
            <form string="New Membership">
                <group>
                    <group>
                        <field name="partner_id" />
                        <field name="invoice_partner_id" />
                        <field name="company_id" />
                        <field name="product_domain" invisible="1" />
                        <field name="product_id" domain="product_domain" />
                    </group>
                    <group>
                        <field name="date_start" />
                        <field name="currency_id" invisible="1" />
                        <field name="amount" />
                        <field name="membership_number_preview" />
                        <field name="activate" />
                    </group>
                </group>
                <group invisible="not activate">
                    <group string="Contribution">
                        <field name="contribution_year" options="{'format': false}" />
                        <field name="create_contribution" />
                    </group>
                    <group string="Welcome Message">
                        <field name="send_welcome_message" />
                        <field
                            name="mail_partner_ids"
                            widget="many2many_tags"
                            invisible="not send_welcome_message"
                        />
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Create" type="object" class="btn-primary" />
                    <button string="Discard" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_membership_new_wizard" model="ir.actions.act_window">
        <field name="name">New Membership</field>
        <field name="res_model">membership.new.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="association_membership.view_membership_new_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
