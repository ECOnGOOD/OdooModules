<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_cancel_wizard_form" model="ir.ui.view">
        <field name="name">membership.cancel.wizard.form</field>
        <field name="model">membership.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Membership">
                <group>
                    <field name="membership_id" />
                    <field name="date_cancelled" />
                    <field name="date_end" />
                    <field name="cancel_reason" />
                    <field
                        name="send_cancellation_message"
                        invisible="not cancellation_template_id"
                    />
                </group>
                <group invisible="not send_cancellation_message">
                    <field name="invoice_partner_included" invisible="1" />
                    <label for="mail_partner_ids" />
                    <div class="o_row" name="mail_partner_ids">
                        <field name="mail_partner_ids" widget="many2many_tags" nolabel="1" />
                        <button
                            name="action_add_invoice_partner"
                            string="Add Invoice Contact"
                            type="object"
                            icon="fa-user-plus"
                            class="btn-link"
                            invisible="invoice_partner_included"
                        />
                    </div>
                    <field name="mail_subject" />
                    <field name="mail_body" widget="html" />
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" />
                    <button string="Discard" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
