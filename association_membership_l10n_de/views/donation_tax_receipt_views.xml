<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="donation_tax_receipt_form_de" model="ir.ui.view">
        <field name="name">donation.tax.receipt.form.de</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_form" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="de_verzicht_aufwendungen" />
                <field name="de_amount_in_words" readonly="1" />
            </field>
        </field>
    </record>
</odoo>
