<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_settings_form_de" model="ir.ui.view">
        <field name="name">membership.settings.form.de</field>
        <field name="model">membership.settings</field>
        <field name="inherit_id" ref="association_membership.view_membership_settings_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='documents']" position="after">
                <page string="Zuwendungsbestätigung (DE)" name="zuwendungsbestaetigung">
                    <group>
                        <group string="Finanzamt">
                            <field name="de_finanzamt_name" string="Finanzamt" />
                            <field name="de_steuernummer" string="Steuernummer" />
                            <field name="de_freistellungsbescheid_date" string="Datum Freistellungsbescheid" />
                            <field name="de_freistellungsbescheid_year" string="Veranlagungszeitraum" />
                        </group>
                        <group string="Bestätigung">
                            <field name="de_charitable_purpose" string="Förderungszweck" />
                            <field name="de_receipt_is_membership" string="Empfänge umfassen Mitgliedsbeiträge" />
                            <field name="de_signatory_name" string="Unterzeichner Name" />
                            <field name="de_signatory_role" string="Unterzeichner Rolle" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
