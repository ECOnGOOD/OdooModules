<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_econgood_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.econgood.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Hide personal information page since its data is used in Demographics -->
            <xpath expr="//page[@name='personal_information_page']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Individuals have no contacts or addresses of their own (16.3a) -->
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">not is_company</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_company_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Organisation fields in their own labelled group: inserted after the
                 Tax ID they lost their labels. The OU flag and OU type are set by
                 administrators; others see them read-only, and only once they are set
                 (each field twice, split by groups). -->
            <xpath expr="//sheet/notebook" position="before">
                <group name="econgood_organisation" string="Organisation" invisible="not is_company">
                    <group>
                        <field name="is_econgood_ou" groups="base.group_system"/>
                        <field
                            name="is_econgood_ou"
                            groups="!base.group_system"
                            readonly="1"
                            invisible="not is_econgood_ou"
                        />
                        <field name="ou_type_id" groups="base.group_system" invisible="not is_econgood_ou"/>
                        <field
                            name="ou_type_id"
                            groups="!base.group_system"
                            readonly="1"
                            invisible="not is_econgood_ou or not ou_type_id"
                        />
                        <field name="organization_kind_id" invisible="is_econgood_ou"/>
                    </group>
                    <group>
                        <field name="partner_company_type_id"/>
                        <field name="nonprofit_status"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//field[@name='website']" position="after">
                <field name="socials"/>
            </xpath>

            <xpath expr="//field[@name='title']" position="after">
                <field name="letter_salutation" invisible="is_company"/>
            </xpath>

            <xpath expr="//field[@name='email']" position="after">
                <field name="email_econgood" widget="email"/>
            </xpath>

            <xpath expr="//notebook/page[@name='accounting']" position="after">
                <page string="Additional Information">
                    <group>
                        <group>
                            <separator string="Demographics"/>
                            <field name="gender" invisible="is_company"/>
                            <field name="birthdate_date" invisible="is_company"/>
                            <field name="age" invisible="not birthdate_date"/>

                            <field name="employee_count" invisible="not is_company"/>
                            <field name="inhabitant_count" invisible="not is_municipality"/>

                            <separator string="Legal Agreements"/>
                            <field name="code_of_conduct_signed_date"/>
                            <field name="privacy_agreement_signed_date"/>
                        </group>

                        <group string="Misc">
                            <field name="ref"/>
                            <field name="company_registry" invisible="not is_company"/>
                            <!-- Administrators only: an edit could drop another association's access (D54). -->
                            <field name="company_ids" widget="many2many_tags" groups="base.group_system" options="{'no_create': True}"/>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company,!base.group_system" readonly="1"/>
                            <field name="industry_id" invisible="not is_company"/>
                            <field name="legacy_id_smartwe"/>
                            <field name="legacy_id_formidable"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Fields by role (roles_and_views.md §4). Accounting staff and administrators see the
         full standard form (group_partner_full_form); membership staff see what they need.
         A field to hide from membership staff gets the group here. Late priority: runs
         after the OCA extensions it moves and hides. -->
    <record id="view_partner_form_econgood_roles" model="ir.ui.view">
        <field name="name">res.partner.form.econgood.roles</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="groups">econgood_extra_fields.group_partner_full_form</attribute>
            </xpath>

            <!-- Invoicing for every internal user: its contents keep Odoo's own groups, and
                 membership staff record the member's payment mode here. -->
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//page[@name='accounting']/group" position="before">
                <group name="payment" string="Payment"/>
            </xpath>
            <xpath expr="//group[@name='payment']" position="inside">
                <xpath expr="//page[@name='sales_purchases']//field[@name='customer_payment_mode_id']" position="move"/>
            </xpath>
            <!-- Its fields are all for accounting staff: no empty heading for others. -->
            <xpath expr="//group[@name='accounting_automation']" position="attributes">
                <attribute name="groups">econgood_extra_fields.group_partner_full_form</attribute>
            </xpath>

            <!-- The companies are shown under Additional Information, editable only for
                 administrators (D54); OCA's editable copy here would bypass that. -->
            <xpath expr="//page[@name='sales_purchases']//field[@name='company_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- OCA partner_contact_address_default: only the contact person is used
         (delivery addresses moved here from association_membership). -->
    <record id="view_partner_form_hide_delivery" model="ir.ui.view">
        <field name="name">res.partner.form.hide.delivery</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_contact_address_default.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_delivery_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='partner_delivery_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- The invoice address is Odoo's standard one: the child contact of type
                 Invoice. A second, manual "Invoice address" only drifts out of sync. -->
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- The organisation's contact person, who receives member emails. -->
            <xpath expr="//field[@name='partner_contact_id']" position="attributes">
                <attribute name="string">Contact Person</attribute>
                <attribute name="invisible">not is_company</attribute>
            </xpath>
            <!-- Child contacts are people: nothing to force there. -->
            <xpath expr="//field[@name='child_ids']//form//group[group/field[@name='partner_invoice_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
